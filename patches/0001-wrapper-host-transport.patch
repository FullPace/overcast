+/* Transport for DSPs that follow the song position (clocked sequencers, synced modulation). Sent before the
+ * block is rendered, so ppqPos is the position of the host block's first frame. */
+static void update_transport(wrap_t *w) {
+    VstTimeInfo *ti = (VstTimeInfo *)w->master(&w->fx, audioMasterGetTime, 0, kVstPpqPosValid | kVstTempoValid, 0, 0);
+    char buf[64];
+    if (!ti) return;
+    snprintf(buf, sizeof buf, "%d %.6f %.4f", (ti->flags & kVstTransportPlaying) ? 1 : 0,
+             (ti->flags & kVstPpqPosValid) ? ti->ppqPos : -1.0, (ti->flags & kVstTempoValid) ? ti->tempo : 0.0);
+    g_api->set_param(w->dsp, "host_transport", buf);
 }
 
